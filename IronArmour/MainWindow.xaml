<Window x:Class="IronArmour.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronArmour"
        mc:Ignorable="d"
        Title="🔐 Iron Armour - Secure Password Vault"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="1000" Height="700">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#FF0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#FF0000"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3333"/>
                                <Setter Property="BorderBrush" Value="#FF3333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#990000"/>
                                <Setter Property="BorderBrush" Value="#990000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FF0000" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#1a1a1a" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Master Password Section -->
        <Border Grid.Row="0" Background="#2a2a2a" CornerRadius="10" Margin="20" Padding="20" Visibility="{Binding MasterPasswordVisibility}">
            <StackPanel>
                <TextBlock Text="🔐 Iron Armour" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#FF0000"/>
                <TextBlock Text="Secure Password Vault" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#CCCCCC"/>
                <TextBlock Text="Master Password:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                <TextBlock Text="This password will encrypt all your stored passwords. Choose a strong, memorable password." FontSize="12" Margin="0,0,0,10" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                <PasswordBox x:Name="MasterPasswordBox" Margin="0,0,0,20" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter a strong master password to protect your vault" KeyDown="MasterPasswordBox_KeyDown"/>
                <Button Content="Set Master Password" Style="{StaticResource ModernButton}" Click="SetMasterPassword_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="#2a2a2a" CornerRadius="10" Margin="20,0,20,20" Visibility="{Binding MainContentVisibility}">
            <TabControl x:Name="MainTabControl" Background="#2a2a2a" BorderBrush="#FF0000" BorderThickness="1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2a2a2a"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5,5,0,0" Margin="2,0,-2,0">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF0000"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="2,2,0,0"/>
                                            <Setter TargetName="Border" Property="Background" Value="#1a1a1a"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Add Password">
                    <StackPanel Margin="20">
                        <TextBlock Text="Account Name:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <TextBox x:Name="AccountNameBox" Margin="0,0,0,15" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter the name of the account (e.g., Gmail, GitHub)"/>
                        <TextBlock Text="Password:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter the password to store securely"/>
                        <TextBlock x:Name="PasswordStrengthIndicator" Margin="0,0,0,10" FontSize="12" Visibility="Collapsed"/>
                        <Button Content="Add Password" Style="{StaticResource ModernButton}" Click="AddPassword_Click"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="View Passwords">
                    <StackPanel Margin="20">
                        <Button Content="List Accounts" Style="{StaticResource ModernButton}" Margin="0,0,0,10" Click="ListAccounts_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Password Strength Report (PDF)" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="ExportPasswordStrengthPdfReport_Click"/>
                            <Button Content="Password Strength Report (CSV)" Style="{StaticResource ModernButton}" Click="ExportPasswordStrengthCsvReport_Click"/>
                        </StackPanel>
                        <ListBox x:Name="AccountsListBox" Height="250" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Margin="0,0,10,0" Foreground="#FFFFFF"/>
                                        <Button Content="View" Style="{StaticResource ModernButton}" Click="ViewPassword_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Generate OTP">
                    <StackPanel Margin="20">
                        <TextBlock Text="Account Name:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <TextBox x:Name="OtpAccountBox" Margin="0,0,0,15" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter the account name for OTP generation"/>
                        <TextBlock Text="Username:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <TextBox x:Name="OtpUsernameBox" Margin="0,0,0,15" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter your username for this account"/>
                        <TextBlock Text="OTP Secret:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <PasswordBox x:Name="OtpSecretBox" Margin="0,0,0,15" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Enter the secret key for OTP generation"/>
                        <TextBlock Text="Password Length:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FFFFFF" FontSize="14"/>
                        <TextBox x:Name="OtpLengthBox" Text="16" Margin="0,0,0,20" Padding="10" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF" ToolTip="Choose password length (8-32 characters)"/>
                        <Button Content="Generate OTP Password" Style="{StaticResource ModernButton}" Click="GenerateOtp_Click"/>
                        <TextBlock x:Name="OtpResultText" Margin="0,20,0,0" FontFamily="Consolas" Background="#1a1a1a" Foreground="#00FF00" Padding="10" Visibility="Collapsed"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Wi-Fi Analysis">
                    <StackPanel Margin="20">
                        <Button Content="Analyze Wi-Fi Passwords" Style="{StaticResource ModernButton}" Margin="0,0,0,10" Click="AnalyzeWifi_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Export PDF Report" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="ExportWifiPdfReport_Click"/>
                            <Button Content="Export CSV Report" Style="{StaticResource ModernButton}" Click="ExportWifiCsvReport_Click"/>
                        </StackPanel>
                        <ListBox x:Name="WifiListBox" Height="250" BorderBrush="#FF0000" BorderThickness="2" Background="#1a1a1a" Foreground="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" Foreground="#FF0000"/>
                                        <TextBlock Text="{Binding Password}" FontFamily="Consolas" Margin="0,5,0,0" Foreground="#00FF00"/>
                                        <TextBlock Text="{Binding Strength}" Margin="0,5,0,0" Foreground="{Binding StrengthColor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <!-- Sync Settings -->
                            <Border Background="#2a2a2a" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF0000" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🔄 Server Synchronization" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#FF0000"/>
                                    <CheckBox x:Name="EnableSyncCheckBox" Content="Enable server synchronization" Margin="0,0,0,15" Foreground="#FFFFFF"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Server URL:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                        <TextBox x:Name="ServerUrlBox" Grid.Column="1" Padding="8" BorderBrush="#FF0000" BorderThickness="1" Background="#1a1a1a" Foreground="#FFFFFF" Text="https://api.ironarmour.com"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Auth Token:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                        <PasswordBox x:Name="AuthTokenBox" Grid.Column="1" Padding="8" BorderBrush="#FF0000" BorderThickness="1" Background="#1a1a1a" Foreground="#FFFFFF"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sync Mode:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                        <ComboBox x:Name="SyncDirectionCombo" Grid.Column="1" Background="#1a1a1a" Foreground="#FFFFFF" BorderBrush="#FF0000" BorderThickness="1">
                                            <ComboBoxItem Content="Disabled"/>
                                            <ComboBoxItem Content="One-way (Local → Server)"/>
                                            <ComboBoxItem Content="One-way (Server → Local)"/>
                                            <ComboBoxItem Content="Two-way sync"/>
                                            <ComboBoxItem Content="Manual sync only"/>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="AutoSyncCheckBox" Content="Enable automatic sync" Margin="0,0,0,15" Foreground="#FFFFFF"/>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sync Interval (min):" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                        <TextBox x:Name="SyncIntervalBox" Grid.Column="1" Text="60" Padding="8" BorderBrush="#FF0000" BorderThickness="1" Background="#1a1a1a" Foreground="#FFFFFF"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <Button Content="🔗 Test Connection" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Margin="0,0,10,0" Click="TestConnection_Click"/>
                                        <Button Content="🔄 Sync Now" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" Click="SyncNow_Click"/>
                                    </StackPanel>

                                    <Border Background="#1a1a1a" CornerRadius="5" Padding="10">
                                        <TextBlock x:Name="SyncStatusText" Text="🔄 Sync Status: Ready" FontWeight="SemiBold" Foreground="#00FF00"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Excluded Accounts -->
                            <Border Background="#2a2a2a" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#FF0000" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🚫 Excluded Accounts" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#FF0000"/>
                                    <TextBlock Text="Accounts to exclude from sync (comma-separated):" Margin="0,0,0,10" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="ExcludedAccountsBox" Height="60" AcceptsReturn="True" Padding="10" BorderBrush="#FF0000" BorderThickness="1" Background="#1a1a1a" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Save Settings -->
                            <Button Content="💾 Save Settings" Background="#2196F3" Foreground="White" BorderThickness="0" Padding="15,10" FontWeight="SemiBold" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status Message -->
        <Border Grid.Row="1" Background="#2a2a2a" BorderBrush="#FF0000" BorderThickness="1" CornerRadius="5" Margin="20" Padding="15" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="{Binding StatusVisibility}">
            <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
        </Border>

        <!-- Close Button -->
        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25,15,15,0" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="CloseButton_Click"/>
    </Grid>
    </Border>
</Window>
